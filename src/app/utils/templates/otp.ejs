<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>Your OTP Code</title>
    <style>
        body {
            font-family: 'Inter', 'Helvetica Neue', Helvetica, Arial, sans-serif;
            background-color: #f4f7f6;
            margin: 0;
            padding: 40px 0;
            -webkit-font-smoothing: antialiased;
        }

        .main {
            background-color: #ffffff;
            margin: 0 auto;
            width: 100%;
            max-width: 500px;
            border-collapse: collapse;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
            overflow: hidden;
        }

        .header {
            background-color: #28a745;
            padding: 30px;
            color: #ffffff;
            text-align: center;
        }

        .header h1 {
            margin: 0;
            font-size: 24px;
            font-weight: 600;
        }

        .content {
            padding: 40px 30px;
            text-align: center;
        }

        .greeting {
            font-size: 20px;
            font-weight: 600;
            margin-bottom: 15px;
            color: #111111;
        }

        .text {
            font-size: 15px;
            line-height: 1.6;
            color: #555555;
            margin-bottom: 30px;
        }

        .otp-box {
            display: inline-block;
            background-color: #f8f9fa;
            border: 2px dashed #cccccc;
            padding: 15px 30px;
            font-size: 32px;
            font-weight: 700;
            letter-spacing: 5px;
            color: #111111;
            border-radius: 8px;
            margin-bottom: 30px;
        }

        .notice {
            font-size: 13px;
            color: #777777;
            background-color: #f8f9fa;
            padding: 15px;
            border-radius: 6px;
        }

        .footer {
            background-color: #f9fbfc;
            padding: 20px;
            text-align: center;
            font-size: 13px;
            color: #888888;
            border-top: 1px solid #eeeeee;
        }
    </style>
</head>
<body>
    <table class="main">
        <tr>
            <td class="header">
                <h1>Verification Code</h1>
            </td>
        </tr>
        <tr>
            <td class="content">
                <div class="greeting">Hello <%= name %>,</div>
                <div class="text">
                    Here is your One-Time Password (OTP) to process your request. Please enter it in the app to continue.
                </div>

                <div class="otp-box"><%= otp %></div>

                <div class="notice">
                    This verification code is valid for <strong>2 minutes</strong>.<br>
                    Please do not share this code with anyone.
                </div>
            </td>
        </tr>
        <tr>
            <td class="footer">
                &copy; <%= new Date().getFullYear() %> Tour Management System. All rights reserved.
            </td>
        </tr>
    </table>
</body>
</html>