<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>Password Reset Request</title>
    <style>
        body {
            font-family: 'Inter', 'Helvetica Neue', Helvetica, Arial, sans-serif;
            background-color: #f4f7f6;
            margin: 0;
            padding: 40px 0;
            -webkit-font-smoothing: antialiased;
        }

        .main {
            background-color: #ffffff;
            margin: 0 auto;
            width: 100%;
            max-width: 500px;
            border-collapse: collapse;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
            overflow: hidden;
        }

        .header {
            background-color: #1a202c;
            padding: 30px;
            color: #ffffff;
            text-align: center;
        }

        .header h1 {
            margin: 0;
            font-size: 24px;
            font-weight: 600;
        }

        .content {
            padding: 40px 30px;
            text-align: center;
        }

        .greeting {
            font-size: 20px;
            font-weight: 600;
            margin-bottom: 15px;
            color: #111111;
        }

        .text {
            font-size: 15px;
            line-height: 1.6;
            color: #555555;
            margin-bottom: 30px;
        }

        .btn-container {
            margin-bottom: 30px;
        }

        .btn {
            display: inline-block;
            padding: 14px 28px;
            background-color: #2F80ED;
            color: #ffffff !important;
            text-decoration: none;
            font-size: 16px;
            font-weight: 600;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(47, 128, 237, 0.2);
            transition: background-color 0.3s ease;
        }

        .notice {
            font-size: 13px;
            color: #777777;
            background-color: #f8f9fa;
            padding: 15px;
            border-radius: 6px;
        }

        .footer {
            background-color: #f9fbfc;
            padding: 20px;
            text-align: center;
            font-size: 13px;
            color: #888888;
            border-top: 1px solid #eeeeee;
        }
    </style>
</head>
<body>
    <table class="main">
        <tr>
            <td class="header">
                <h1>Password Reset</h1>
            </td>
        </tr>
        <tr>
            <td class="content">
                <div class="greeting">Hello <%= name %>,</div>
                <div class="text">
                    We received a request to reset the password for your account. If you initiated this request, please click the button below to set a new password.
                </div>

                <div class="btn-container">
                    <a href="<%= resetLink %>" class="btn">Reset Password</a>
                </div>

                <div class="notice">
                    This link will expire in <strong>10 minutes</strong>.<br>
                    If you did not request this, you can safely ignore this email.
                </div>
            </td>
        </tr>
        <tr>
            <td class="footer">
                &copy; <%= new Date().getFullYear() %> Tour Management System. All rights reserved.
            </td>
        </tr>
    </table>
</body>
</html>